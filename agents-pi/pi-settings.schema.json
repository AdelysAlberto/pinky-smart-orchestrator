{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pi Agent Settings",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Ruta o URL del esquema JSON"
    },
    "lastChangelogVersion": {
      "type": "string"
    },
    "defaultProvider": {
      "type": "string",
      "description": "Proveedor LLM por defecto al iniciar"
    },
    "defaultModel": {
      "type": "string",
      "description": "ID del modelo por defecto al iniciar"
    },
    "defaultThinkingLevel": {
      "type": "string",
      "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"],
      "description": "Nivel de razonamiento por defecto"
    },
    "modelThinkingLevels": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["off", "minimal", "low", "medium", "high", "xhigh", "max"]
      },
      "description": "Nivel de razonamiento por modelo específico (formato 'provider/modelId')"
    },
    "thinkingBudgets": {
      "type": "object",
      "properties": {
        "minimal": { "type": "integer" },
        "low": { "type": "integer" },
        "medium": { "type": "integer" },
        "high": { "type": "integer" },
        "xhigh": { "type": "integer" },
        "max": { "type": "integer" }
      },
      "description": "Presupuesto en tokens para cada nivel de razonamiento"
    },
    "hideThinkingBlock": {
      "type": "boolean",
      "default": false,
      "description": "Oculta el bloque de razonamiento en la UI"
    },
    "showCacheMissNotices": {
      "type": "boolean",
      "default": false,
      "description": "Muestra notificaciones de fallos/aciertos en la caché de prompts"
    },
    "cacheWarming": {
      "type": "string",
      "enum": ["off", "streaming", "idle"],
      "default": "streaming",
      "description": "Modo de mantenimiento de la caché de prompts"
    },
    "theme": {
      "type": "string",
      "default": "dark",
      "description": "Nombre del tema visual de la TUI"
    },
    "externalEditor": {
      "type": "string",
      "description": "Comando para editor externo al presionar Ctrl+G (ej. 'code --wait')"
    },
    "quietStartup": {
      "type": ["boolean", "string"],
      "default": false,
      "description": "Oculta el banner/cabecera inicial"
    },
    "defaultProjectTrust": {
      "type": "string",
      "enum": ["ask", "always", "never"],
      "default": "ask",
      "description": "Comportamiento por defecto de confianza para configuraciones locales de proyecto"
    },
    "collapseChangelog": {
      "type": "boolean",
      "default": false
    },
    "enableInstallTelemetry": {
      "type": "boolean",
      "default": true
    },
    "enableAnalytics": {
      "type": "boolean",
      "default": false
    },
    "trackingId": {
      "type": "string"
    },
    "doubleEscapeAction": {
      "type": "string",
      "enum": ["tree", "fork", "none"],
      "default": "tree",
      "description": "Acción ejecutada al pulsar dos veces Escape"
    },
    "treeFilterMode": {
      "type": "string",
      "enum": ["default", "no-tools", "user-only", "labeled-only", "all"],
      "default": "default"
    },
    "editorPaddingX": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "default": 0
    },
    "outputPad": {
      "type": "integer",
      "enum": [0, 1],
      "default": 1
    },
    "autocompleteMaxVisible": {
      "type": "integer",
      "minimum": 3,
      "maximum": 20,
      "default": 5
    },
    "showHardwareCursor": {
      "type": "boolean",
      "default": false
    },
    "tuiMode": {
      "type": "string",
      "enum": ["regular", "fullscreen"],
      "default": "regular"
    },
    "fullscreenExitOutput": {
      "type": "string",
      "enum": ["transcript", "resume-hint"],
      "default": "transcript"
    },
    "fullscreenScrollbar": {
      "type": "string",
      "enum": ["auto", "always", "hidden"],
      "default": "auto"
    },
    "fullscreenCopyOnSelect": {
      "type": "boolean",
      "default": true
    },
    "terminal": {
      "type": "object",
      "properties": {
        "showImages": {
          "type": "boolean",
          "default": true,
          "description": "Show images in terminal (if supported)"
        },
        "images": {
          "type": ["string", "boolean"],
          "default": "auto",
          "description": "Override image protocol support with 'kitty', 'iterm2', false, or 'auto'"
        },
        "imageWidthCells": {
          "type": "integer",
          "default": 60,
          "description": "Preferred inline image width in terminal cells"
        },
        "clearOnShrink": {
          "type": "boolean",
          "default": false,
          "description": "Clear empty rows when content shrinks (can cause flicker)"
        },
        "hyperlinks": {
          "type": ["boolean", "string"],
          "default": "auto",
          "description": "Override OSC 8 hyperlink support"
        },
        "trueColor": {
          "type": ["boolean", "string"],
          "default": "auto",
          "description": "Override truecolor support"
        }
      },
      "additionalProperties": true
    },
    "terminal.showImages": {
      "type": "boolean",
      "default": true,
      "description": "Show images in terminal (if supported)"
    },
    "terminal.images": {
      "type": ["string", "boolean"],
      "default": "auto",
      "description": "Override image protocol support with 'kitty', 'iterm2', false, or 'auto'"
    },
    "terminal.imageWidthCells": {
      "type": "integer",
      "default": 60,
      "description": "Preferred inline image width in terminal cells"
    },
    "images": {
      "type": "object",
      "properties": {
        "autoResize": {
          "type": "boolean",
          "default": true,
          "description": "Resize images to 2000x2000 max. Applies to @file attachments, read, and images returned by tools"
        },
        "blockImages": {
          "type": "boolean",
          "default": false,
          "description": "Block all images from being sent to LLM"
        }
      },
      "additionalProperties": true
    },
    "images.autoResize": {
      "type": "boolean",
      "default": true,
      "description": "Resize images to 2000x2000 max. Applies to @file attachments, read, and images returned by tools"
    },
    "images.blockImages": {
      "type": "boolean",
      "default": false,
      "description": "Block all images from being sent to LLM"
    },
    "compaction": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "reserveTokens": { "type": "integer", "default": 16384 },
        "keepRecentTokens": { "type": "integer", "default": 20000 },
        "modelOverrides": { "type": "object" }
      }
    },
    "packages": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Lista de paquetes/extensiones instalados"
    },
    "httpProxy": {
      "type": "string"
    },
    "warnings": {
      "type": "object",
      "properties": {
        "anthropicExtraUsage": { "type": "boolean", "default": true }
      }
    }
  },
  "additionalProperties": true
}
