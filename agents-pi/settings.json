{
  "$schema": "./pi-settings.schema.json",
  "lastChangelogVersion": "0.87.1",
  "theme": "titanium",
  "quietStartup": "true",
  "defaultThinkingLevel": "medium",
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-todo",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@nguyenquangthai/pi-omp-theme",
    "npm:pi-subagents"
  ],
  "hideThinkingBlock": true,
  "treeFilterMode": "default",
  "doubleEscapeAction": "tree",
  "editorPaddingX": 2,
  "terminal": {
    "showImages": true,
    "images": "auto"
  },
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "fullscreenExitOutput": "resume-hint",
  "fullscreenScrollbar": "always",
  "scopeModels": true,
  "outputPad": 1,
  "httpIdleTimeoutMs": 120000,
  "subagents": {
    "disableBuiltins": true,
    "defaultContext": "fresh",
    "toolTimeoutMs": 180000,
    "agentOverrides": {
      "homero": {
        "model": "deepseek/deepseek-flash",
        "thinking": "low"
      },
      "tio-bob": {
        "model": "deepseek/deepseek-flash",
        "thinking": "low"
      },
      "sheldon": {
        "model": "deepseek/deepseek-flash",
        "thinking": "medium"
      }
    }
  }
}