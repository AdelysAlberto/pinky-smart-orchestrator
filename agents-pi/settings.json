{
  "$schema": "https://pi.dev/schemas/settings.schema.json",
  "theme": "titanium",
  "piOmpTheme": {
    "tools": {
      "enabled": false
    }
  },
  "quietStartup": true,
  "defaultThinkingLevel": "medium",
  "packages": [
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-todo",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@nguyenquangthai/pi-omp-theme",
    "npm:pi-subagents"
  ],
  "hideThinkingBlock": true,
  "treeFilterMode": "default",
  "doubleEscapeAction": "tree",
  "editorPaddingX": 2,
  "terminal": {
    "showImages": true,
    "images": "auto"
  },
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "fullscreenExitOutput": "resume-hint",
  "fullscreenScrollbar": "always",
  "scopeModels": true,
  "outputPad": 1,
  "httpIdleTimeoutMs": 120000,
  "showCacheMissNotices": true,
  "retry": {
    "enabled": true,
    "maxRetries": 2,
    "maxAgentDelayMs": 30000
  },
  "extensions": [
    "+builtin:mcp",
    "+extensions/compact-tool-boxes.ts"
  ],
  "subagents": {
    "disableBuiltins": true,
    "defaultContext": "fresh",
    "defaultThinking": "medium",
    "agentOverrides": {
      "homero": {
        "thinking": "medium"
      },
      "tio-bob": {
        "thinking": "high"
      },
      "sheldon": {
        "thinking": "medium"
      }
    }
  }
}